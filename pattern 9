class Solution {
public:
    void pattern9(int n) {
        for(int i=0; i<2*n; i++){
            if(i>=n){
                for(int j=0; j<i-n; j++){
                cout<<" ";
            }
                for(int j=0; j<(2*n - 1) - 2*(i-n); j++){
                    cout<<"*";
                }
            }
            else{
            for(int j=0; j<n-i-1; j++){
                cout<<" ";
            }
            for(int j=0; j<2*i+1; j++){
                cout<<"*";
            }}

            cout<<endl;
        }

    }
};
