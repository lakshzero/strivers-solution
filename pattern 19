class Solution {
public:
    void pattern19(int n) {
        int space = 0;

        for(int i = 0; i < n; i++) {
            for(int j = 0; j < n-i; j++) {
                cout << "*";
            }

            for(int j = 0; j < space; j++) {
                cout << " ";
            }

            for(int j = 0; j < n-i; j++) {
                cout << "*";
            }

            space = space + 2;
            cout << endl;
        }

        space = 2*n - 2;

        for(int i = 0; i < n; i++) {
            for(int j = 0; j <= i; j++) {
                cout << "*";
            }

            for(int j = 0; j < space; j++) {
                cout << " ";
            }

            for(int j = 0; j <= i; j++) {
                cout << "*";
            }

            space = space - 2;
            cout << endl;
        }
    }
};




//alternate method 
class Solution {
public:
    void pattern19(int n) {

        for(int i = 0; i < 2*n; i++) {

            if(i < n) {
                // Upper half

                for(int j = 0; j < n-i; j++)
                    cout << "*";

                for(int j = 0; j < 2*i; j++)
                    cout << " ";

                for(int j = 0; j < n-i; j++)
                    cout << "*";
            }

            else {
                // Lower half

                for(int j = 0; j <= i-n; j++)
                    cout << "*";

                for(int j = 0; j < 2*n-2-2*(i-n); j++)
                    cout << " ";

                for(int j = 0; j <= i-n; j++)
                    cout << "*";
            }

            cout << endl;
        }
    }
};//
