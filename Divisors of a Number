class Solution {
public:
    vector<int> divisors(int n) {
        vector<int>ans;
        for(int i=1; i<=n; i++){
            if(n%i==0){
                ans.emplace_back(i);
            }

        }
        return ans;

    }
};













\\alternate version
class Solution {
public:
    vector<int> divisors(int n) {
        vector<int> ans;

        for(int i = 1; i <= sqrt(n); i++) {
            if(n % i == 0) {
                ans.emplace_back(i);

                if(i != n / i) {
                    ans.emplace_back(n / i);
                }
            }
        }
        sort (ans.begin(),ans.end());

        return ans;
    }
};
