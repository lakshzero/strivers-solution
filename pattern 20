class Solution {
public:
    void pattern20(int n) {
        for(int i=0; i<2*n-1; i++){

            if(i<n){

                for(int j=0; j<=i; j++){
                    cout<<"*";
                }

                for(int j=0; j<(n*2-2)-(2*i); j++){
                    cout<<" ";
                }

                for(int j=0; j<=i; j++){
                    cout<<"*";
                }

            }
            else{

                for(int j=0; j<2*n-1-i; j++){
                    cout<<"*";
                }

                for(int j=0; j<(i-n)*2+2; j++){
                    cout<<" ";
                }

                for(int j=0; j<2*n-1-i; j++){
                    cout<<"*";
                }

            }

            cout<<endl;
        }
    }
};
