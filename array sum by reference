#include <iostream>
#include <vector>
using namespace std;

   class Solution {
public:
    int sumArray(vector<int>& arr) {
        int sum = 0;
        int j= arr.size() - 1;
        for(int i=0; i<=j; i++){
           sum = sum + arr[i];
        }
        return sum;
    }
   };
int main(){
    int n;
    cin >> n;
    vector<int> arr(n);
       for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }
    Solution obj;
    int sum = obj.sumArray(arr);
    cout << sum <<" ";
    return 0;
};
