class Solution {
public:
    void pattern10(int n) {
        for(int i=1; i<=n*2-1;i++){
            if(i>n){
                for(int j=0; j<2*n-i; j++){
                    cout<<"*";
                }

            }
            else{
            for(int j=1; j<=i; j++){
                cout<<"*";
            }}

             cout<<endl;
        }

    }
};
